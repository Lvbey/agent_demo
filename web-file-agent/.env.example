# Copy to .env and fill in your provider settings.
OPENAI_API_KEY=
# Optional. Use your provider's OpenAI-compatible API base URL.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=

# Relative paths are resolved from the process working directory.
AGENT_WORKSPACE=./workspace
MAX_STEPS=8
REQUEST_TIMEOUT=20
MAX_FILE_BYTES=1000000
MAX_WEB_BYTES=1000000
